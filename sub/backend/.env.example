# Copy this file to ".env" in this same folder (backend).
# Put your real key on the line below. Do not use quotes.
# The backend loads .env automatically; you do not need $env:GEMINI_API_KEY each time.

GEMINI_API_KEY=paste_your_key_here

# Optional: force a specific Gemini model (default tries gemini-2.0-flash then fallbacks)
# GEMINI_MODEL=gemini-1.5-flash
